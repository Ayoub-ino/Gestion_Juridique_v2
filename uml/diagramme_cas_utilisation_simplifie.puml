@startuml Diagramme de Cas d'Utilisation - Gestion Juridique (simplifie)
' ============================================================
' Diagramme de Cas d'Utilisation - Version simplifiee
' Projet : Gestion Juridique - Cour d'Appel Administrative de Fes
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 13
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}

' ============================================================
' ACTEURS PRINCIPAUX (roles metier)
' ============================================================

actor "Administrateur" as Admin
actor "Agent Bureau\nd'Ordre" as BO
actor "Agent Ouverture\ndes Dossiers" as OD
actor "Agent Secretariat" as Sec
actor "Agent Seances\n& Procedures" as Seance
actor "Agent Expertise" as Expert
actor "Agent Delivrance\ndes Copies" as Taslim
actor "Agent Reglement\ndes Depens" as Tasfiya
actor "Agent Archive" as Arch
actor "Agent Notification" as Tabligh

' ============================================================
' SOUS-SYSTEMES
' ============================================================

rectangle "Authentification & Profil" {
  usecase "S'authentifier\n(JWT + BCrypt)" as UC_Auth
  usecase "Consulter son profil" as UC_Profil
}

rectangle "Tableau de bord" {
  usecase "Consulter le tableau\nde bord (stats, activite)" as UC_Dashboard
}

rectangle "Gestion des Documents" {
  usecase "Creer un courrier\nadministratif" as UC_CreerAdmin
  usecase "Creer un dossier\njuridique" as UC_CreerJuridique
  usecase "Creer un courrier\nsortant" as UC_CreerSortant
  usecase "Modifier un document" as UC_Modifier
  usecase "Supprimer un document\n(soft delete)" as UC_Supprimer
  usecase "Consulter les details\nd'un document" as UC_Detail
  usecase "Telecharger un fichier" as UC_Download
  usecase "Importer via Excel" as UC_ImportExcel
}

rectangle "Transfert & Circuit Juridique" {
  usecase "Transferer un document\nvers un service" as UC_Transferer
  usecase "Transferer un dossier\njuridique (circuit)" as UC_TransferJuridique
  usecase "Avancer l'etape\njuridique" as UC_EtapeSuivante
  usecase "Reculer l'etape\njuridique" as UC_EtapePrecedente
}

rectangle "Transactions & Notifications" {
  usecase "Accepter un transfert" as UC_Accepter
  usecase "Refuser un transfert" as UC_Refuser
  usecase "Annuler un transfert" as UC_Annuler
  usecase "Consulter les\ntransactions" as UC_Transactions
  usecase "Recevoir des\nnotifications" as UC_Notifications
}

rectangle "Recherche & Export" {
  usecase "Recherche avancee\nde documents" as UC_Recherche
  usecase "Exporter en Excel" as UC_ExportExcel
  usecase "Exporter en Word" as UC_ExportWord
}

rectangle "Espace de travail" {
  usecase "Ouvrir l'espace\nde travail" as UC_Workspace
  usecase "Ajouter des notes" as UC_Notes
  usecase "Consulter l'historique\ndes modifications" as UC_Historique
  usecase "Gerer les acces\n(ACL Owner/Editor/Viewer)" as UC_ACL
}

rectangle "Mes Entites" {
  usecase "Consulter mes entites\n(documents recus)" as UC_MesEntites
  usecase "Consulter mes dossiers\nen cours" as UC_DossiersEnCours
}

rectangle "Archives" {
  usecase "Consulter les archives" as UC_Archives
  usecase "Archiver un document" as UC_Archiver
  usecase "Restaurer un document\n(depuis corbeille)" as UC_Restaurer
  usecase "Supprimer definitivement" as UC_PermanentDelete
  usecase "Enregistrer un retrait\nd'archive" as UC_Retrait
}

rectangle "Administration RBAC" {
  usecase "Gerer les utilisateurs" as UC_GererUsers
  usecase "Gerer les services\nRBAC" as UC_GererServices
  usecase "Gerer les permissions\npar service" as UC_GererPermissions
  usecase "Gerer les equipements" as UC_GererEquipements
  usecase "Gerer les listes\ndynamiques" as UC_GererListes
  usecase "Gerer les substituts" as UC_GererSubstituts
}

' ============================================================
' RELATIONS
' ============================================================

' Auth (tous)
Admin --> UC_Auth
BO --> UC_Auth
OD --> UC_Auth
Sec --> UC_Auth
Seance --> UC_Auth
Expert --> UC_Auth
Taslim --> UC_Auth
Tasfiya --> UC_Auth
Arch --> UC_Auth
Tabligh --> UC_Auth

Admin --> UC_Profil
BO --> UC_Profil
OD --> UC_Profil
Sec --> UC_Profil
Seance --> UC_Profil
Expert --> UC_Profil
Taslim --> UC_Profil
Tasfiya --> UC_Profil
Arch --> UC_Profil
Tabligh --> UC_Profil

' Dashboard
BO --> UC_Dashboard
OD --> UC_Dashboard
Sec --> UC_Dashboard
Seance --> UC_Dashboard
Expert --> UC_Dashboard
Taslim --> UC_Dashboard
Tasfiya --> UC_Dashboard
Arch --> UC_Dashboard
Tabligh --> UC_Dashboard
Admin --> UC_Dashboard

' Creation
BO --> UC_CreerAdmin : <<permission>>
BO --> UC_CreerSortant : <<permission>>
OD --> UC_CreerJuridique : <<permission>>
Sec --> UC_CreerSortant : <<permission>>

' Modification
BO --> UC_Modifier : <<permission>>
BO --> UC_Supprimer : <<permission>>
OD --> UC_Modifier
Arch --> UC_Supprimer : <<permission>>

' Detail / Fichiers
BO --> UC_Detail
OD --> UC_Detail
Sec --> UC_Detail
Seance --> UC_Detail
Expert --> UC_Detail
Taslim --> UC_Detail
Tasfiya --> UC_Detail
Arch --> UC_Detail
Tabligh --> UC_Detail
BO --> UC_Download : <<permission>>
BO --> UC_ImportExcel : <<permission>>
OD --> UC_ImportExcel : <<permission>>

' Transfert
BO --> UC_Transferer : <<permission>>
OD --> UC_Transferer : <<permission>>
Sec --> UC_Transferer : <<permission>>
Seance --> UC_Transferer : <<permission>>
Expert --> UC_Transferer : <<permission>>
Taslim --> UC_Transferer : <<permission>>
Tasfiya --> UC_Transferer : <<permission>>
Tabligh --> UC_Transferer : <<permission>>

' Circuit juridique
OD --> UC_TransferJuridique : <<permission>>
Seance --> UC_TransferJuridique : <<permission>>
Expert --> UC_TransferJuridique : <<permission>>
Taslim --> UC_TransferJuridique : <<permission>>
Tasfiya --> UC_TransferJuridique : <<permission>>
Arch --> UC_TransferJuridique : <<permission>>
Tabligh --> UC_TransferJuridique : <<permission>>
Seance --> UC_EtapeSuivante : <<permission>>
Seance --> UC_EtapePrecedente : <<permission>>
Expert --> UC_EtapeSuivante : <<permission>>
Expert --> UC_EtapePrecedente : <<permission>>

' Transactions
BO --> UC_Accepter : <<permission>>
OD --> UC_Accepter : <<permission>>
Sec --> UC_Accepter : <<permission>>
Seance --> UC_Accepter : <<permission>>
Expert --> UC_Accepter : <<permission>>
Taslim --> UC_Accepter : <<permission>>
Tasfiya --> UC_Accepter : <<permission>>
Arch --> UC_Accepter : <<permission>>
Tabligh --> UC_Accepter : <<permission>>
BO --> UC_Refuser : <<permission>>
BO --> UC_Annuler : <<permission>>
BO --> UC_Transactions
BO --> UC_Notifications

' Recherche / Export
BO --> UC_Recherche : <<permission>>
OD --> UC_Recherche : <<permission>>
Sec --> UC_Recherche : <<permission>>
Seance --> UC_Recherche : <<permission>>
Expert --> UC_Recherche : <<permission>>
Taslim --> UC_Recherche : <<permission>>
Tasfiya --> UC_Recherche : <<permission>>
Arch --> UC_Recherche : <<permission>>
Tabligh --> UC_Recherche : <<permission>>
BO --> UC_ExportExcel : <<permission>>
BO --> UC_ExportWord : <<permission>>

' Espace de travail
BO --> UC_Workspace : <<permission>>
OD --> UC_Workspace : <<permission>>
Sec --> UC_Workspace : <<permission>>
Seance --> UC_Workspace : <<permission>>
Expert --> UC_Workspace : <<permission>>
BO --> UC_Notes : <<permission>>
BO --> UC_Historique : <<permission>>
Admin --> UC_ACL : <<permission>>

' Entites
BO --> UC_MesEntites
OD --> UC_MesEntites
Sec --> UC_MesEntites
Seance --> UC_MesEntites
Expert --> UC_MesEntites
Taslim --> UC_MesEntites
Tasfiya --> UC_MesEntites
Arch --> UC_MesEntites
Tabligh --> UC_MesEntites
BO --> UC_DossiersEnCours

' Archives
Arch --> UC_Archives : <<permission>>
Arch --> UC_Archiver : <<permission>>
Arch --> UC_Restaurer : <<permission>>
Arch --> UC_PermanentDelete : <<permission>>
Arch --> UC_Retrait : <<permission>>

' Administration (Admin)
Admin --> UC_GererUsers : <<permission>>
Admin --> UC_GererServices : <<permission>>
Admin --> UC_GererPermissions : <<permission>>
Admin --> UC_GererEquipements : <<permission>>
Admin --> UC_GererListes : <<permission>>
Admin --> UC_GererSubstituts : <<permission>>

' ============================================================
' RELATIONS INCLUDE / EXTEND
' ============================================================

UC_CreerAdmin ..> UC_Transferer : <<include>>
UC_CreerJuridique ..> UC_TransferJuridique : <<include>>
UC_Archiver ..> UC_Archives : <<include>>
UC_PermanentDelete ..> UC_Archives : <<include>>
UC_Retrait ..> UC_Archives : <<include>>
UC_Download ..> UC_Detail : <<include>>
UC_Notes ..> UC_Workspace : <<include>>
UC_Historique ..> UC_Workspace : <<include>>
UC_ACL ..> UC_Workspace : <<include>>

UC_Restaurer ..> UC_Supprimer : <<extend>>
UC_Annuler ..> UC_Transferer : <<extend>>

' ============================================================
' HERITAGE ACTEURS
' ============================================================

Admin <|-- Greffier : herite (bypass ACL)
Admin <|-- Directeur : herite (bypass ACL)
Admin <|-- Consultant : herite (bypass ACL)

@enduml
