@startuml Diagramme de Cas d'Utilisation Simplifié V2
' ============================================================
' Version simplifiée — Diagramme global avec sous-systèmes
' Regroupe les cas d'utilisation par domaine fonctionnel
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 12
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}

' ============================================================
' ACTEURS
' ============================================================

actor "Administrateur" as Admin
actor "Agent\nde service" as Agent
actor "Chef du greffe /\nAutorité habilitée" as Chef

rectangle "Système de Gestion Juridique\n(Cour d'Appel Administrative de Fès)" {

  ' === SOUS-SYSTÈMES ===

  rectangle "Authentification & Profil" {
    usecase "S'authentifier (JWT + BCrypt)" as UC_Auth
    usecase "Consulter son profil" as UC_Profil
    usecase "Consulter le tableau de bord" as UC_Dashboard
  }

  rectangle "Gestion des Documents" {
    usecase "Créer un courrier administratif" as UC_CreerAdmin
    usecase "Créer un dossier juridique" as UC_CreerJuridique
    usecase "Créer un courrier sortant" as UC_CreerSortant
    usecase "Modifier un document" as UC_Modifier
    usecase "Supprimer un document (soft delete)" as UC_Supprimer
    usecase "Consulter les détails" as UC_Detail
    usecase "Télécharger un fichier" as UC_Download
    usecase "Importer via Excel" as UC_Import
  }

  rectangle "Transfert & Circuit Juridique" {
    usecase "Transférer un document\n(unique / diffusion / 1..n)" as UC_Transferer
    usecase "Transférer un dossier\njudiciaire (circuit 6 étapes)" as UC_TransJuridique
    usecase "Avancer/Reculer l'étape\njudiciaire (Jalsat)" as UC_Etapes
    usecase "Ouvrir un dossier judiciaire" as UC_Ouvrir
    usecase "Clôturer un dossier" as UC_Clôturer
  }

  rectangle "Transactions & Notifications" {
    usecase "Accepter un transfert" as UC_Accepter
    usecase "Refuser un transfert\n(motif obligatoire)" as UC_Refuser
    usecase "Annuler un transfert\n(doit-revenir)" as UC_Annuler
    usecase "Consulter les transactions\n+ notifications" as UC_Tx
  }

  rectangle "Recherche & Export" {
    usecase "Recherche avancée" as UC_Recherche
    usecase "Exporter Excel / Word" as UC_Export
  }

  rectangle "Espace de travail" {
    usecase "Ouvrir l'espace de travail" as UC_Workspace
    usecase "Ajouter des notes" as UC_Notes
    usecase "Consulter l'historique" as UC_Historique
  }

  rectangle "Archives & Corbeille" {
    usecase "Archiver un document" as UC_Archiver
    usecase "Voir la corbeille" as UC_Corbeille
    usecase "Restaurer un document" as UC_Restaurer
    usecase "Supprimer définitivement" as UC_PermanentDelete
    usecase "Enregistrer un retrait\nde dossier" as UC_Retrait
    usecase "Voir les archives" as UC_VoirArchives
  }

  rectangle "Administration RBAC" {
    usecase "Gérer les utilisateurs\n(CRUD + soft-delete)" as UC_GererUsers
    usecase "Gérer les services RBAC\n(soft-delete)" as UC_GererServices
    usecase "Gérer la matrice\ndes permissions (18 clés)" as UC_GererPerms
    usecase "Gérer les overrides\nadmin (séparation)" as UC_GererOverrides
    usecase "Gérer équipements\n& listes dynamiques" as UC_GererEquips
  }
}

' ============================================================
' RELATIONS — AGENT (représente tous les agents de service)
' ============================================================

Agent --> UC_Auth
Agent --> UC_Profil
Agent --> UC_Dashboard

Agent --> UC_CreerAdmin
Agent --> UC_CreerJuridique
Agent --> UC_CreerSortant
Agent --> UC_Modifier
Agent --> UC_Supprimer
Agent --> UC_Detail
Agent --> UC_Download
Agent --> UC_Import

Agent --> UC_Transferer
Agent --> UC_TransJuridique
Agent --> UC_Etapes
Agent --> UC_Ouvrir

Agent --> UC_Accepter
Agent --> UC_Refuser
Agent --> UC_Annuler
Agent --> UC_Tx

Agent --> UC_Recherche
Agent --> UC_Export

Agent --> UC_Workspace
Agent --> UC_Notes
Agent --> UC_Historique

Agent --> UC_Archiver
Agent --> UC_Corbeille
Agent --> UC_Restaurer
Agent --> UC_PermanentDelete

' ============================================================
' RELATIONS — ADMIN
' ============================================================

Admin --> UC_Auth
Admin --> UC_Profil
Admin --> UC_Dashboard

Admin --> UC_GererUsers
Admin --> UC_GererServices
Admin --> UC_GererPerms
Admin --> UC_GererOverrides
Admin --> UC_GererEquips

Admin --> UC_VoirArchives
Admin --> UC_Recherche
Admin --> UC_Export
Admin --> UC_Detail

' ============================================================
' RELATIONS — CHEF DU GREFFE (autorité habilitée)
' ============================================================

Chef --> UC_Retrait
Chef --> UC_VoirArchives

' ============================================================
' INCLUDE / EXTEND
' ============================================================

UC_CreerAdmin ..> UC_Transferer : <<include>>
UC_CreerJuridique ..> UC_TransJuridique : <<include>>
UC_Archiver ..> UC_VoirArchives : <<include>>
UC_PermanentDelete ..> UC_Corbeille : <<include>>
UC_Retrait ..> UC_VoirArchives : <<include>>
UC_Download ..> UC_Detail : <<include>>
UC_Notes ..> UC_Workspace : <<include>>
UC_Historique ..> UC_Workspace : <<include>>
UC_GererPerms ..> UC_GererServices : <<include>>
UC_GererOverrides ..> UC_GererPerms : <<include>>

UC_Restaurer ..> UC_Supprimer : <<extend>>
UC_Annuler ..> UC_Transferer : <<extend>>

' ============================================================
' NOTES
' ============================================================

note bottom of Agent
  **Agents de service (9 services RBAC) :**
  Chaque agent est lié à un service via RBAC.
  Ses permissions dépendent de son service.
  Les permissions sont gérées dynamiquement
  par l'Administrateur via la matrice.

  **Services :** Bureau d'ordre, Ouverture,
  Secrétariat, Séances, Expertise, Délivrance,
  Règlement dépens, Archive, Notification
end note

note bottom of Admin
  **Administrateur :**
  • Configure le système (utilisateurs, services, permissions)
  • **Ne participe PAS** au circuit opérationnel
  • Séparation des tâches via AdminPermissionOverrides
  • 20 permissions désactivées par défaut
end note

note right of UC_TransJuridique
  **Circuit judiciaire en 6 étapes :**
  1. Bureau d'ordre → 2. Ouverture dossiers
  → 3. Secrétariat particulier
  → 4. Séances & audiences
  → 5. Délivrance & clôture
  → 6. Archives
  Boucle de refus avec rollback
end note

@enduml
