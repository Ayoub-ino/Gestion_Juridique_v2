@startuml Diagramme de Cas d'Utilisation par Service RBAC
' ============================================================
' Diagrammes de Cas d'Utilisation PAR SERVICE
' Chaque service RBAC a ses propres permissions
' Source : SeederService.cs → serviceDefaults dictionary
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 11
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}

' ============================================================
' BUREAU D'ORDRE (bureauordre)
' Permissions : creer_modifier, creer_courrier_admin, supprimer,
' transferer, consulter, accepter, refuser, annuler_transfert,
' dashboard, mes_entites, transactions, recherche_avancee,
' export_excel, export_word, voir_historique, voir_workspace,
' telecharger_fichiers, ajouter_notes, profil
' ============================================================

rectangle "Service : Bureau d'ordre\n(bureauordre) — 19 permissions" as S_BO {
  actor "Agent Bureau\nd'Ordre" as BO

  rectangle "Auth" {
    usecase "S'authentifier" as BO_Auth
    usecase "Mon profil" as BO_Profil
  }
  rectangle "Documents" {
    usecase "Créer courrier\nadministratif" as BO_CreerAdmin
    usecase "Créer courrier\nsortant" as BO_CreerSortant
    usecase "Modifier document" as BO_Modifier
    usecase "Supprimer\n(soft delete)" as BO_Supprimer
    usecase "Importer Excel" as BO_Import
  }
  rectangle "Transfert" {
    usecase "Transférer" as BO_Transferer
  }
  rectangle "Notifications" {
    usecase "Accepter" as BO_Accepter
    usecase "Refuser" as BO_Refuser
    usecase "Annuler transfert" as BO_Annuler
  }
  rectangle "Recherche & Export" {
    usecase "Recherche\navancée" as BO_Recherche
    usecase "Export Excel" as BO_ExportExcel
    usecase "Export Word" as BO_ExportWord
  }
  rectangle "Autres" {
    usecase "Dashboard" as BO_Dash
    usecase "Mes entités" as BO_MesEnt
    usecase "Transactions" as BO_Tx
    usecase "Espace de\ntravail" as BO_WS
    usecase "Notes" as BO_Notes
    usecase "Historique" as BO_Hist
    usecase "Télécharger\nfichiers" as BO_DL
  }
}

BO --> BO_Auth
BO --> BO_Profil
BO --> BO_CreerAdmin
BO --> BO_CreerSortant
BO --> BO_Modifier
BO --> BO_Supprimer
BO --> BO_Import
BO --> BO_Transferer
BO --> BO_Accepter
BO --> BO_Refuser
BO --> BO_Annuler
BO --> BO_Recherche
BO --> BO_ExportExcel
BO --> BO_ExportWord
BO --> BO_Dash
BO --> BO_MesEnt
BO --> BO_Tx
BO --> BO_WS
BO --> BO_Notes
BO --> BO_Hist
BO --> BO_DL

' ============================================================
' OUVERTURE DES DOSSIERS (fathmilafat)
' Permissions : creer_modifier, creer_courrier_juridique, transferer,
' transferer_juridique, consulter, ouvrir_dossier, accepter, refuser,
' annuler_transfert, dashboard, mes_entites, transactions,
' recherche_avancee, export_excel, export_word, voir_historique,
' voir_workspace, telecharger_fichiers, ajouter_notes, profil
' ============================================================

rectangle "Service : Ouverture des dossiers\n(fathmilafat) — 20 permissions" as S_OD {
  actor "Agent\nOuverture" as OD

  rectangle "Documents" {
    usecase "Créer/Modifier\ndocument" as OD_Creer
    usecase "Créer dossier\njudiciaire" as OD_Juridique
  }
  rectangle "Juridique" {
    usecase "Ouvrir dossier\njudiciaire" as OD_Ouvrir
    usecase "Transférer\njudiciaire" as OD_TransJ
  }
  rectangle "Transfert" {
    usecase "Transférer" as OD_Trans
    usecase "Accepter" as OD_Accepter
    usecase "Refuser" as OD_Refuser
    usecase "Annuler" as OD_Annuler
  }
  rectangle "Recherche & Export" {
    usecase "Recherche\navancée" as OD_Recherche
    usecase "Export Excel" as OD_Excel
    usecase "Export Word" as OD_Word
  }
  rectangle "Autres" {
    usecase "Dashboard\n+ Mes entités\n+ Espace travail\n+ Notes + Historique" as OD_Autres
  }
}

OD --> OD_Creer
OD --> OD_Juridique
OD --> OD_Ouvrir
OD --> OD_TransJ
OD --> OD_Trans
OD --> OD_Accepter
OD --> OD_Refuser
OD --> OD_Annuler
OD --> OD_Recherche
OD --> OD_Excel
OD --> OD_Word
OD --> OD_Autres

' ============================================================
' SECRÉTARIAT (secretarait) — 16 permissions
' Pas de création de documents ! (transferer, consulter, accepter,
' refuser, annuler_transfert, dashboard, mes_entites, transactions,
' recherche_avancee, export_excel, export_word, voir_historique,
' voir_workspace, telecharger_fichiers, ajouter_notes, profil)
' ============================================================

rectangle "Service : Secrétariat\n(secretarait) — 16 permissions\n⚠ PAS DE CRÉATION" as S_SEC {
  actor "Agent\nSecrétariat" as Sec

  rectangle "Transfert & Notifications" {
    usecase "Transférer\n(seulement)" as Sec_Trans
    usecase "Accepter" as Sec_Accepter
    usecase "Refuser" as Sec_Refuser
    usecase "Annuler" as Sec_Annuler
  }
  rectangle "Recherche & Export" {
    usecase "Recherche\navancée" as Sec_Recherche
    usecase "Export Excel/Word" as Sec_Export
  }
  rectangle "Autres" {
    usecase "Dashboard\n+ Mes entités\n+ Espace travail\n+ Notes + Historique" as Sec_Autres
  }
}

Sec --> Sec_Trans
Sec --> Sec_Accepter
Sec --> Sec_Refuser
Sec --> Sec_Annuler
Sec --> Sec_Recherche
Sec --> Sec_Export
Sec --> Sec_Autres

' ============================================================
' SÉANCES & PROCÉDURES (seances&procedures) — 19 permissions
' transferer, transferer_juridique, consulter, etape_precedente,
' etape_suivante, accepter, refuser, annuler_transfert, dashboard,
' mes_entites, transactions, recherche_avancee, export_excel,
' export_word, voir_historique, voir_workspace, telecharger_fichiers,
' ajouter_notes, profil
' ============================================================

rectangle "Service : Séances & Procédures\n(seances&procedures) — 19 permissions\n+ étapes juridiques" as S_SEANCE {
  actor "Agent\nSéances" as Seance

  rectangle "Juridique" {
    usecase "Transférer\njudiciaire" as Seance_TransJ
    usecase "Avancer étape\n(Jalsat)" as Seance_Avancer
    usecase "Reculer étape" as Seance_Reculer
  }
  rectangle "Transfert" {
    usecase "Transférer" as Seance_Trans
    usecase "Accepter" as Seance_Accepter
    usecase "Refuser" as Seance_Refuser
  }
  rectangle "Autres" {
    usecase "Dashboard + Recherche\n+ Export + Notes\n+ Historique" as Seance_Autres
  }
}

Seance --> Seance_TransJ
Seance --> Seance_Avancer
Seance --> Seance_Reculer
Seance --> Seance_Trans
Seance --> Seance_Accepter
Seance --> Seance_Refuser
Seance --> Seance_Autres

' ============================================================
' ARCHIVE (archive) — 20 permissions
' archiver, supprimer, restaurer, voir_corbeille, retrait_archive,
' transferer_juridique, consulter, accepter, refuser,
' annuler_transfert, dashboard, mes_entites, archives_view,
' recherche_avancee, export_excel, export_word, voir_historique,
' voir_workspace, telecharger_fichiers, profil
' ============================================================

rectangle "Service : Archive\n(archive) — 20 permissions\n+ corbeille + retraits" as S_ARCH {
  actor "Agent\nArchive" as Arch

  rectangle "Archives & Corbeille" {
    usecase "Archiver\ndocument" as Arch_Archiver
    usecase "Voir corbeille" as Arch_Corbeille
    usecase "Restaurer" as Arch_Restaurer
    usecase "Supprimer\ndéfinitivement" as Arch_Delete
    usecase "Voir archives" as Arch_VoirArchives
    usecase "Retrait\nde dossier" as Arch_Retrait
  }
  rectangle "Juridique" {
    usecase "Transférer\njudiciaire" as Arch_TransJ
  }
  rectangle "Transfert" {
    usecase "Accepter" as Arch_Accepter
    usecase "Refuser" as Arch_Refuser
  }
  rectangle "Autres" {
    usecase "Dashboard + Recherche\n+ Export + Historique" as Arch_Autres
  }
}

Arch --> Arch_Archiver
Arch --> Arch_Corbeille
Arch --> Arch_Restaurer
Arch --> Arch_Delete
Arch --> Arch_VoirArchives
Arch --> Arch_Retrait
Arch --> Arch_TransJ
Arch --> Arch_Accepter
Arch --> Arch_Refuser
Arch --> Arch_Autres

' ============================================================
' INCLUDE / EXTEND
' ============================================================

OD_Juridique ..> OD_TransJ : <<include>>
Arch_Archiver ..> Arch_VoirArchives : <<include>>
Arch_Delete ..> Arch_Corbeille : <<include>>
Arch_Retrait ..> Arch_VoirArchives : <<include>>

note bottom of S_ARCH
  **Service Archive — unique dans le système :**
  • Seul service avec corbeille + restauration
  • Seul service avec gestion des retraits
  • Gère les suppressions définitives
  • Pas de création de documents
end note

note bottom of S_SEC
  **Secrétariat — rôle relayeur :**
  • Pas de création de documents
  • Peut seulement transférer et
    accepter/refuser des transferts
  • Correspond au circuit "Kitaba Khasa"
end note

note bottom of S_SEANCE
  **Séances — circuit Jalsat :**
  • Seul service (avec Expertise) à avoir
    les permissions etape_suivante/precedente
  • Gère les audiences, enquêtes,
    commissaire du roi, expertise
end note

@enduml
