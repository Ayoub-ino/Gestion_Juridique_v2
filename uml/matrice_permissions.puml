skinparam defaultTextAlignment center
skinparam backgroundColor white
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam noteFontSize 10
skinparam defaultFontSize 11

title Matrice des Permissions RBAC — Gestion Juridique\nd'après le code source (SeederService.cs)

' Use a table-like approach with packages
' Actually, let's use a proper UML approach

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #CCCCCC
  RoundCorner 10
}

skinparam package {
  BackgroundColor #F5F8FD
  BorderColor #2E74B5
  FontSize 13
  FontStyle bold
}

