@startuml Diagramme de Cas d'Utilisation - Gestion Juridique
' ============================================================
' Diagramme de Cas d'Utilisation
' Projet : Gestion Juridique - Cour d'Appel Administrative de Fes
' Auteurs : [Votre nom]
' Date : 2026
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 13
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #CCCCCC
}

' ============================================================
' ACTEURS PRINCIPAUX
' ============================================================

actor "Administrateur" as Admin
actor "Agent Bureau\nd'Ordre" as BO
actor "Agent Ouverture\ndes Dossiers" as OD
actor "Agent Secretariat" as Sec
actor "Agent Seances\n& Procedures" as Seance
actor "Agent Expertise" as Expert
actor "Agent Delivrance\ndes Copies" as Taslim
actor "Agent Reglement\ndes Depens" as Tasfiya
actor "Agent Archive" as Arch
actor "Agent Notification" as Tabligh
actor "Greffier" as Greffier
actor "Directeur" as Directeur
actor "Consultant" as Consultant

' ============================================================
' SYSTÈME
' ============================================================

rectangle "Système de Gestion Juridique\n(Cour d'Appel Administrative de Fès)" {

  ' --- Authentification ---
  usecase "S'authentifier\n(JWT + BCrypt)" as UC_Auth
  usecase "Consulter son profil" as UC_Profil

  ' --- Tableau de bord ---
  usecase "Consulter le tableau\nde bord" as UC_Dashboard

  ' --- Gestion des documents ---
  usecase "Créer un courrier\nadministratif" as UC_CreerAdmin
  usecase "Créer un dossier\njuridique" as UC_CreerJuridique
  usecase "Créer un courrier\nsortant" as UC_CreerSortant
  usecase "Modifier un document" as UC_Modifier
  usecase "Supprimer un document\n(soft delete)" as UC_Supprimer
  usecase "Consulter les détails\nd'un document" as UC_Detail
  usecase "Télécharger un fichier" as UC_Download
  usecase "Importer des documents\nvia Excel" as UC_ImportExcel

  ' --- Transfert & Workflow ---
  usecase "Transférer un document\nvers un service" as UC_Transferer
  usecase "Transférer un dossier\njuridique (circuit)" as UC_TransferJuridique
  usecase "Avancer l'étape\njuridique" as UC_EtapeSuivante
  usecase "Reculer l'étape\njuridique" as UC_EtapePrecedente

  ' --- Transactions ---
  usecase "Accepter un transfert" as UC_Accepter
  usecase "Refuser un transfert" as UC_Refuser
  usecase "Annuler un transfert" as UC_Annuler
  usecase "Consulter les\ntransactions" as UC_Transactions
  usecase "Recevoir des\nnotifications" as UC_Notifications

  ' --- Recherche & Export ---
  usecase "Recherche avancée\nde documents" as UC_Recherche
  usecase "Exporter en Excel" as UC_ExportExcel
  usecase "Exporter en Word" as UC_ExportWord

  ' --- Espace de travail ---
  usecase "Ouvrir l'espace\nde travail" as UC_Workspace
  usecase "Ajouter des notes" as UC_Notes
  usecase "Consulter l'historique\ndes modifications" as UC_Historique
  usecase "Gérer les accès\n(ACL Owner/Editor/Viewer)" as UC_ACL

  ' --- Entités ---
  usecase "Consulter mes entités\n(documents reçus)" as UC_MesEntites
  usecase "Consulter mes dossiers\nen cours" as UC_DossiersEnCours

  ' --- Archives ---
  usecase "Consulter les archives" as UC_Archives
  usecase "Archiver un document" as UC_Archiver
  usecase "Restaurer un document\n(depuis corbeille)" as UC_Restaurer
  usecase "Supprimer définitivement" as UC_PermanentDelete
  usecase "Enregistrer un retrait\nd'archive" as UC_Retrait

  ' --- Administration RBAC ---
  usecase "Gérer les utilisateurs" as UC_GererUsers
  usecase "Gérer les services\nRBAC" as UC_GererServices
  usecase "Gérer les permissions\npar service" as UC_GererPermissions
  usecase "Gérer les équipements" as UC_GererEquipements
  usecase "Gérer les listes\ndynamiques" as UC_GererListes
  usecase "Gérer les substituts" as UC_GererSubstituts
  usecase "Gérer les services\nhistoriques" as UC_GererServicesHist
}

' ============================================================
' RELATIONS ACTEURS → CAS D'UTILISATION
' ============================================================

' --- Tous les utilisateurs ---
Admin --> UC_Auth
BO --> UC_Auth
OD --> UC_Auth
Sec --> UC_Auth
Seance --> UC_Auth
Expert --> UC_Auth
Taslim --> UC_Auth
Tasfiya --> UC_Auth
Arch --> UC_Auth
Tabligh --> UC_Auth
Greffier --> UC_Auth
Directeur --> UC_Auth
Consultant --> UC_Auth

Admin --> UC_Profil
BO --> UC_Profil
OD --> UC_Profil
Sec --> UC_Profil
Seance --> UC_Profil
Expert --> UC_Profil
Taslim --> UC_Profil
Tasfiya --> UC_Profil
Arch --> UC_Profil
Tabligh --> UC_Profil

' --- Tableau de bord (tous sauf Admin qui a un dashboard restreint) ---
BO --> UC_Dashboard
OD --> UC_Dashboard
Sec --> UC_Dashboard
Seance --> UC_Dashboard
Expert --> UC_Dashboard
Taslim --> UC_Dashboard
Tasfiya --> UC_Dashboard
Arch --> UC_Dashboard
Tabligh --> UC_Dashboard
Admin --> UC_Dashboard

' --- Création de documents ---
BO --> UC_CreerAdmin : <<permission>>\ncreer_courrier_admin
BO --> UC_CreerSortant : <<permission>>\ncreer_modifier
OD --> UC_CreerJuridique : <<permission>>\ncreer_courrier_juridique
Sec --> UC_CreerSortant : <<permission>>\ncreer_modifier

' --- Modification / Suppression (selon custody) ---
BO --> UC_Modifier : <<permission>>\ncreer_modifier
BO --> UC_Supprimer : <<permission>>\nsupprimer
OD --> UC_Modifier
Arch --> UC_Supprimer : <<permission>>\nsupprimer

' --- Détail / Fichiers (tous) ---
BO --> UC_Detail
OD --> UC_Detail
Sec --> UC_Detail
Seance --> UC_Detail
Expert --> UC_Detail
Taslim --> UC_Detail
Tasfiya --> UC_Detail
Arch --> UC_Detail
Tabligh --> UC_Detail

BO --> UC_Download : <<permission>>\ntelecharger_fichiers

' --- Import Excel ---
BO --> UC_ImportExcel : <<permission>>\ncreer_courrier_admin
OD --> UC_ImportExcel : <<permission>>\ncreer_courrier_juridique

' --- Transfert ---
BO --> UC_Transferer : <<permission>>\ntransferer
OD --> UC_Transferer : <<permission>>\ntransferer
Sec --> UC_Transferer : <<permission>>\ntransferer
Seance --> UC_Transferer : <<permission>>\ntransferer
Expert --> UC_Transferer : <<permission>>\ntransferer
Taslim --> UC_Transferer : <<permission>>\ntransferer
Tasfiya --> UC_Transferer : <<permission>>\ntransferer
Tabligh --> UC_Transferer : <<permission>>\ntransferer

' --- Circuit juridique ---
OD --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Seance --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Expert --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Taslim --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Tasfiya --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Arch --> UC_TransferJuridique : <<permission>>\ntransferer_juridique
Tabligh --> UC_TransferJuridique : <<permission>>\ntransferer_juridique

Seance --> UC_EtapeSuivante : <<permission>>\netape_suivante
Seance --> UC_EtapePrecedente : <<permission>>\netape_precedente
Expert --> UC_EtapeSuivante : <<permission>>\netape_suivante
Expert --> UC_EtapePrecedente : <<permission>>\netape_precedente

' --- Transactions ---
BO --> UC_Accepter : <<permission>>\naccepter
OD --> UC_Accepter : <<permission>>\naccepter
Sec --> UC_Accepter : <<permission>>\naccepter
Seance --> UC_Accepter : <<permission>>\naccepter
Expert --> UC_Accepter : <<permission>>\naccepter
Taslim --> UC_Accepter : <<permission>>\naccepter
Tasfiya --> UC_Accepter : <<permission>>\naccepter
Arch --> UC_Accepter : <<permission>>\naccepter
Tabligh --> UC_Accepter : <<permission>>\naccepter

BO --> UC_Refuser : <<permission>>\nrefuser
OD --> UC_Refuser : <<permission>>\nrefuser
Sec --> UC_Refuser : <<permission>>\nrefuser
Seance --> UC_Refuser : <<permission>>\nrefuser
Expert --> UC_Refuser : <<permission>>\nrefuser
Taslim --> UC_Refuser : <<permission>>\nrefuser
Tasfiya --> UC_Refuser : <<permission>>\nrefuser
Arch --> UC_Refuser : <<permission>>\nrefuser
Tabligh --> UC_Refuser : <<permission>>\nrefuser

BO --> UC_Annuler : <<permission>>\nannuler_transfert
OD --> UC_Annuler : <<permission>>\nannuler_transfert
BO --> UC_Transactions
OD --> UC_Transactions
BO --> UC_Notifications
OD --> UC_Notifications

' --- Recherche & Export ---
BO --> UC_Recherche : <<permission>>\nrecherche_avancee
OD --> UC_Recherche : <<permission>>\nrecherche_avancee
Sec --> UC_Recherche : <<permission>>\nrecherche_avancee
Seance --> UC_Recherche : <<permission>>\nrecherche_avancee
Expert --> UC_Recherche : <<permission>>\nrecherche_avancee
Taslim --> UC_Recherche : <<permission>>\nrecherche_avancee
Tasfiya --> UC_Recherche : <<permission>>\nrecherche_avancee
Arch --> UC_Recherche : <<permission>>\nrecherche_avancee
Tabligh --> UC_Recherche : <<permission>>\nrecherche_avancee

BO --> UC_ExportExcel : <<permission>>\nexport_excel
OD --> UC_ExportExcel : <<permission>>\nexport_excel
BO --> UC_ExportWord : <<permission>>\nexport_word

' --- Espace de travail ---
BO --> UC_Workspace : <<permission>>\nvoir_workspace
OD --> UC_Workspace : <<permission>>\nvoir_workspace
Sec --> UC_Workspace : <<permission>>\nvoir_workspace
Seance --> UC_Workspace : <<permission>>\nvoir_workspace
Expert --> UC_Workspace : <<permission>>\nvoir_workspace

BO --> UC_Notes : <<permission>>\najouter_notes
OD --> UC_Notes : <<permission>>\najouter_notes
BO --> UC_Historique : <<permission>>\nvoir_historique
OD --> UC_Historique : <<permission>>\nvoir_historique
Admin --> UC_ACL : <<permission>>\ngerer_permissions

' --- Entités ---
BO --> UC_MesEntites
OD --> UC_MesEntites
Sec --> UC_MesEntites
Seance --> UC_MesEntites
Expert --> UC_MesEntites
Taslim --> UC_MesEntites
Tasfiya --> UC_MesEntites
Arch --> UC_MesEntites
Tabligh --> UC_MesEntites

BO --> UC_DossiersEnCours
OD --> UC_DossiersEnCours

' --- Archives ---
Arch --> UC_Archives : <<permission>>\narchives_view
Arch --> UC_Archiver : <<permission>>\narchiver
Arch --> UC_Restaurer : <<permission>>\nrestaurer
Arch --> UC_Supprimer : <<permission>>\nsupprimer
Arch --> UC_PermanentDelete : <<permission>>\nsupprimer
Arch --> UC_Retrait : <<permission>>\nretrait_archive

' --- Administration (Admin uniquement) ---
Admin --> UC_GererUsers : <<permission>>\ngerer_utilisateurs
Admin --> UC_GererServices : <<permission>>\ngerer_services
Admin --> UC_GererPermissions : <<permission>>\ngerer_permissions
Admin --> UC_GererEquipements : <<permission>>\ngerer_equipements
Admin --> UC_GererListes : <<permission>>\ngerer_listes
Admin --> UC_GererSubstituts : <<permission>>\ngerer_substituts
Admin --> UC_GererServicesHist : <<permission>>\ngerer_services

' ============================================================
' RELATIONS INCLUDE / EXTEND
' ============================================================

UC_CreerAdmin ..> UC_Transferer : <<include>>\n(unique/diffusion)
UC_CreerJuridique ..> UC_TransferJuridique : <<include>>\n(auto → OuvertureDossier)
UC_Archiver ..> UC_Archives : <<include>>
UC_PermanentDelete ..> UC_Archives : <<include>>
UC_Retrait ..> UC_Archives : <<include>>
UC_Download ..> UC_Detail : <<include>>
UC_Notes ..> UC_Workspace : <<include>>
UC_Historique ..> UC_Workspace : <<include>>
UC_ACL ..> UC_Workspace : <<include>>

UC_Restaurer ..> UC_Supprimer : <<extend>>
UC_Annuler ..> UC_Transferer : <<extend>>

' ============================================================
' HÉRARCHIE D'HÉRITAGE (actors)
' ============================================================

Admin <|-- Greffier : hérite (bypass ACL)
Admin <|-- Directeur : hérite (bypass ACL)
Admin <|-- Consultant : hérite (bypass ACL)

@enduml
