@startuml Diagramme de Cas d'Utilisation - Administrateur
' ============================================================
' Diagramme de Cas d'Utilisation — ADMINISTRATEUR
' avec AdminPermissionOverrides (séparation des tâches)
' Source : SeederService.cs, PermissionService.cs, RbacPermissionsController.cs
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 12
}
skinparam actor {
  BackgroundColor #8B0000
  FontColor white
  BorderColor #5C0000
}

actor "Administrateur" as Admin

rectangle "Système de Gestion Juridique\nAdministration RBAC" {

  ' --- Auth ---
  rectangle "Authentification" {
    usecase "S'authentifier\n(JWT + BCrypt)" as UC_Auth
    usecase "Consulter son profil" as UC_Profil
  }

  ' --- Administration RBAC ---
  rectangle "Gestion des Utilisateurs\n(gerer_utilisateurs)" {
    usecase "Créer un utilisateur\n(login, mdp, service)" as UC_CreerUser
    usecase "Modifier un utilisateur\n(changer service, mdp)" as UC_ModifierUser
    usecase "Archiver un utilisateur\n(soft-delete)" as UC_ArchiverUser
    usecase "Restaurer un utilisateur" as UC_RestaurerUser
    usecase "Supprimer définitivement" as UC_SupprimerUser
  }

  rectangle "Gestion des Services\n(gerer_services)" {
    usecase "Créer un service RBAC\n(nom, code, description)" as UC_CreerService
    usecase "Modifier un service" as UC_ModifierService
    usecase "Archiver un service\n(soft-delete)" as UC_ArchiverService
    usecase "Restaurer un service" as UC_RestaurerService
    usecase "Supprimer définitivement\n(bloqué si utilisateurs)" as UC_SupprimerService
  }

  rectangle "Matrice des Permissions\n(gerer_permissions)" {
    usecase "Consulter la matrice\nservices × permissions" as UC_VoirMatrice
    usecase "Modifier les permissions\nd'un service\n(activer/désactiver)" as UC_ModifierPermsService
    usecase "Gérer les overrides\nadmin\n(séparation des tâches)" as UC_GererOverrides
    usecase "Consulter les permissions\ncurrent de mon compte" as UC_MesPerms
  }

  rectangle "Gestion des Équipements\n(gerer_equipements)" {
    usecase "Créer/Modifier/Archiver\néquipements" as UC_Equipements
  }

  rectangle "Gestion des Listes\n(gerer_listes)" {
    usecase "Créer/Modifier/Archiver\nlistes dynamiques" as UC_Listes
  }

  rectangle "Gestion Services\nHistoriques" {
    usecase "Créer/Modifier/Supprimer\nservices historiques\n(enregistrement seul)" as UC_ServicesHist
  }

  ' --- Lecture seule ---
  rectangle "Consultation (lecture seule)" {
    usecase "Consulter le\ntableau de bord" as UC_Dashboard
    usecase "Consulter les registres\ndes transactions" as UC_Registre
    usecase "Consulter les archives" as UC_Archives
    usecase "Recherche avancée" as UC_Recherche
    usecase "Export Excel / Word" as UC_Export
  }
}

' ============================================================
' RELATIONS
' ============================================================

Admin --> UC_Auth
Admin --> UC_Profil

' Administration RBAC
Admin --> UC_CreerUser
Admin --> UC_ModifierUser
Admin --> UC_ArchiverUser
Admin --> UC_RestaurerUser
Admin --> UC_SupprimerUser

Admin --> UC_CreerService
Admin --> UC_ModifierService
Admin --> UC_ArchiverService
Admin --> UC_RestaurerService
Admin --> UC_SupprimerService

Admin --> UC_VoirMatrice
Admin --> UC_ModifierPermsService
Admin --> UC_GererOverrides
Admin --> UC_MesPerms

Admin --> UC_Equipements
Admin --> UC_Listes
Admin --> UC_ServicesHist

' Lecture seule
Admin --> UC_Dashboard
Admin --> UC_Registre
Admin --> UC_Archives
Admin --> UC_Recherche
Admin --> UC_Export

' ============================================================
' INCLUDE
' ============================================================

UC_ArchiverUser ..> UC_RestaurerUser : <<extend>>
UC_SupprimerUser ..> UC_ArchiverUser : <<include>>
UC_SupprimerService ..> UC_ArchiverService : <<include>>
UC_ModifierPermsService ..> UC_VoirMatrice : <<include>>
UC_GererOverrides ..> UC_MesPerms : <<include>>

' ============================================================
' NOTES
' ============================================================

note right of UC_GererOverrides
  **AdminPermissionOverrides :**
  L'Admin a TOUS les permissions par défaut,
  mais 20 permissions sont **désactivées**
  par les overrides pour la **séparation
  des tâches** :

  ✗ creer_modifier, transferer, supprimer
  ✗ restaurer, archiver, creer_courrier_*
  ✗ accepter, refuser, voir_toutes
  ✗ etape_precedente/suivante
  ✗ ouvrir_dossier, cloturer
  ✗ transferer_juridique, retrait_archive
  ✗ recherche_avancee, export_excel/word
  ✗ ajouter_notes

  **Raison :** L'admin configure le système
  mais ne participe pas au circuit opérationnel
  (audit trail propre)
end note

note bottom of UC_CreerService
  **Cycle de vie d'un service :**
  Création → Actif → Soft-delete →
  (Restauration OU Suppression définitive)
  ⚠ Suppression bloquée si des utilisateurs
  sont assignés au service
end note

note bottom of UC_ServicesHist
  **Services historiques :**
  Entités d'enregistrement uniquement.
  Aucun login, aucune action.
  Utilisés pour l'historique des circuits
  (Recherche, Commissaire du roi, etc.)
  Le transfert vers un service historique
  est auto-accepté.
end note

note bottom of UC_VoirMatrice
  **Matrice RBAC dynamique :**
  GET /api/rbac/permissions/matrix
  9 services × 37 permissions
  Le dashboard affiche la matrice
  complète avec toggle par cellule
end note

@enduml
