@startuml Diagramme de Cas d'Utilisation Complet - Gestion Juridique
' ============================================================
' Diagramme de Cas d'Utilisation GLOBAL
' Projet : Gestion Juridique - Cour d'Appel Administrative de Fes
' Auteurs : Ayoub AGROUKH & Ikrame OUDGHIRI
' Date : 2026
'
' Source : Analyse complète du code (SeederService.cs, PermissionMatrix,
'          RequirePermissionAttribute, Controllers, Cypress E2E tests)
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 12
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #CCCCCC
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #CCAA00
  FontSize 10
}

' ============================================================
' ACTEURS PRINCIPAUX (9 services RBAC + Admin)
' ============================================================

actor "Administrateur" as Admin
actor "Agent Bureau\nd'Ordre" as BO <<bureauordre>>
actor "Agent Ouverture\ndes Dossiers" as OD <<fathmilafat>>
actor "Agent Secrétariat" as Sec <<secretarait>>
actor "Agent Séances\n& Procédures" as Seance <<seances>>
actor "Agent Expertise\nJudiciaire" as Expert <<khibra>>
actor "Agent Délivrance\ndes Copies" as Taslim <<taslimnosakh>>
actor "Agent Règlement\ndes Dépens" as Tasfiya <<tasfiya>>
actor "Agent Archive" as Arch <<archive>>
actor "Agent Notification" as Tabligh <<atabligh>>

' ============================================================
' SYSTÈME
' ============================================================

rectangle "Système de Gestion Juridique\n(Cour d'Appel Administrative de Fès)" {

  ' === AUTHENTIFICATION ===
  rectangle "Authentification" {
    usecase "UC-01 : S'authentifier\n(JWT + BCrypt)" as UC_Auth
    usecase "UC-02 : Consulter\nson profil" as UC_Profil
  }

  ' === TABLEAU DE BORD ===
  rectangle "Tableau de bord" {
    usecase "UC-03 : Consulter le\ntableau de bord\n(stats, activité)" as UC_Dashboard
  }

  ' === GESTION DES DOCUMENTS ===
  rectangle "Gestion des Documents" {
    usecase "UC-04 : Créer un courrier\nadministratif" as UC_CreerAdmin
    usecase "UC-05 : Créer un dossier\njuridique" as UC_CreerJuridique
    usecase "UC-06 : Créer/Modifier\nun courrier sortant" as UC_CreerSortant
    usecase "UC-07 : Modifier\nun document" as UC_Modifier
    usecase "UC-08 : Supprimer un document\n(soft delete → corbeille)" as UC_Supprimer
    usecase "UC-09 : Consulter les détails\nd'un document" as UC_Detail
    usecase "UC-10 : Télécharger\nun fichier" as UC_Download
    usecase "UC-11 : Importer des documents\nvia Excel" as UC_ImportExcel
  }

  ' === TRANSFERT & CIRCUIT ===
  rectangle "Transfert & Circuit Juridique" {
    usecase "UC-12 : Transférer un document\n(unique / diffusion / 1..n)" as UC_Transferer
    usecase "UC-13 : Transférer un dossier\njudiciaire (circuit)" as UC_TransferJuridique
    usecase "UC-14 : Avancer l'étape\njudiciaire (Jalsat)" as UC_AvancerEtape
    usecase "UC-15 : Reculer l'étape\njudiciaire (retour)" as UC_ReculerEtape
    usecase "UC-16 : Ouvrir un dossier\njudiciaire" as UC_OuvrirDossier
    usecase "UC-17 : Clôturer un dossier" as UC_Clôturer
  }

  ' === TRANSACTIONS & NOTIFICATIONS ===
  rectangle "Transactions & Notifications" {
    usecase "UC-18 : Accepter un transfert" as UC_Accepter
    usecase "UC-19 : Refuser un transfert\n(motif obligatoire)" as UC_Refuser
    usecase "UC-20 : Annuler un transfert" as UC_Annuler
    usecase "UC-21 : Consulter les\ntransactions en cours" as UC_Transactions
    usecase "UC-22 : Voir les notifications\n+ doit-revenir" as UC_Notifications
  }

  ' === RECHERCHE & EXPORT ===
  rectangle "Recherche & Export" {
    usecase "UC-23 : Recherche avancée\nde documents" as UC_Recherche
    usecase "UC-24 : Exporter en Excel" as UC_ExportExcel
    usecase "UC-25 : Exporter en Word" as UC_ExportWord
  }

  ' === ESPACE DE TRAVAIL ===
  rectangle "Espace de travail" {
    usecase "UC-26 : Ouvrir l'espace\nde travail (ACL)" as UC_Workspace
    usecase "UC-27 : Ajouter des notes" as UC_Notes
    usecase "UC-28 : Consulter l'historique\ndes modifications" as UC_Historique
  }

  ' === MES ENTITÉS ===
  rectangle "Mes Entités" {
    usecase "UC-29 : Consulter mes entités\n(documents reçus)" as UC_MesEntites
    usecase "UC-30 : Consulter mes dossiers\nen cours" as UC_DossiersEnCours
  }

  ' === ARCHIVES ===
  rectangle "Archives & Corbeille" {
    usecase "UC-31 : Archiver un document" as UC_Archiver
    usecase "UC-32 : Voir la corbeille" as UC_VoirCorbeille
    usecase "UC-33 : Restaurer un document" as UC_Restaurer
    usecase "UC-34 : Supprimer définitivement" as UC_PermanentDelete
    usecase "UC-35 : Voir les archives" as UC_VoirArchives
    usecase "UC-36 : Enregistrer un retrait\nde dossier" as UC_Retrait
  }

  ' === ADMINISTRATION RBAC ===
  rectangle "Administration RBAC" {
    usecase "UC-37 : Gérer les utilisateurs\n(CRUD + soft-delete)" as UC_GererUsers
    usecase "UC-38 : Gérer les services\nRBAC (soft-delete)" as UC_GererServices
    usecase "UC-39 : Gérer la matrice\ndes permissions\n(18 permissions)" as UC_GererPermissions
    usecase "UC-40 : Gérer les overrides\nadmin (séparation)" as UC_GererAdminOverrides
    usecase "UC-41 : Gérer les\néquipements" as UC_GererEquipements
    usecase "UC-42 : Gérer les listes\ndynamiques" as UC_GererListes
    usecase "UC-43 : Gérer les services\nhistoriques" as UC_GererServicesHist
  }
}

