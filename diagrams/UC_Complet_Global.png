<script async="" src="https://cdn-0.plantuml.com/synchro2.min.js"></script>
<script>
function compress(s, pre) {
//UTF8
s = unescape(encodeURIComponent(s));
var arr = [];
for (var i = 0; i < s.length; i++) {
	arr.push(s.charCodeAt(i));
}
var compressor = new Zopfli.RawDeflate(arr);
var compressed = compressor.compress();
dest = "//www.plantuml.com/plantuml" + pre + encode64_(compressed);
window.location.href = dest;
}
function backto(s) {
	var i = s.lastIndexOf("/");
	if (i!=-1) s = s.substring(i+1);

	dest = "//www.plantuml.com/plantuml" + "/uml/"+s;

	window.location.href = dest;
}
</script>

<textarea name="text" id="inflated" spellcheck="false" onkeyup="sendCode()">@startuml
&#39; ============================================================
&#39; Diagramme de Cas d&#39;Utilisation GLOBAL
&#39; Projet : Gestion Juridique - Cour d&#39;Appel Administrative de Fes
&#39; Auteurs : Ayoub AGROUKH &amp; Ikrame OUDGHIRI
&#39; Date : 2026
&#39;
&#39; Source : Analyse complÃ¨te du code (SeederService.cs, PermissionMatrix,
&#39;          RequirePermissionAttribute, Controllers, Cypress E2E tests)
&#39; ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F9F9F9
  BorderColor #333333
  FontSize 12
}
skinparam actor {
  BackgroundColor #4A90D9
  FontColor white
  BorderColor #2C5F8A
}
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #CCCCCC
}
skinparam note {
  BackgroundColor #FFF9E6
  BorderColor #CCAA00
  FontSize 10
}

&#39; ============================================================
&#39; ACTEURS PRINCIPAUX (9 services RBAC + Admin)
&#39; ============================================================

actor &#34;Administrateur&#34; as Admin
actor &#34;Agent Bureau\nd&#39;Ordre&#34; as BO &lt;&lt;bureauordre&gt;&gt;
actor &#34;Agent Ouverture\ndes Dossiers&#34; as OD &lt;&lt;fathmilafat&gt;&gt;
actor &#34;Agent SecrÃ©tariat&#34; as Sec &lt;&lt;secretarait&gt;&gt;
actor &#34;Agent SÃ©ances\n&amp; ProcÃ©dures&#34; as Seance &lt;&lt;seances&gt;&gt;
actor &#34;Agent Expertise\nJudiciaire&#34; as Expert &lt;&lt;khibra&gt;&gt;
actor &#34;Agent DÃ©livrance\ndes Copies&#34; as Taslim &lt;&lt;taslimnosakh&gt;&gt;
actor &#34;Agent RÃ¨glement\ndes DÃ©pens&#34; as Tasfiya &lt;&lt;tasfiya&gt;&gt;
actor &#34;Agent Archive&#34; as Arch &lt;&lt;archive&gt;&gt;
actor &#34;Agent Notification&#34; as Tabligh &lt;&lt;atabligh&gt;&gt;

&#39; ============================================================
&#39; SYSTÃˆME
&#39; ============================================================

rectangle &#34;SystÃ¨me de Gestion Juridique\n(Cour d&#39;Appel Administrative de FÃ¨s)&#34; {

  &#39; === AUTHENTIFICATION ===
  rectangle &#34;Authentification&#34; {
    usecase &#34;UC-01 : S&#39;authentifier\n(JWT + BCrypt)&#34; as UC_Auth
    usecase &#34;UC-02 : Consulter\nson profil&#34; as UC_Profil
  }

  &#39; === TABLEAU DE BORD ===
  rectangle &#34;Tableau de bord&#34; {
    usecase &#34;UC-03 : Consulter le\ntableau de bord\n(stats, activitÃ©)&#34; as UC_Dashboard
  }

  &#39; === GESTION DES DOCUMENTS ===
  rectangle &#34;Gestion des Documents&#34; {
    usecase &#34;UC-04 : CrÃ©er un courrier\nadministratif&#34; as UC_CreerAdmin
    usecase &#34;UC-05 : CrÃ©er un dossier\njuridique&#34; as UC_CreerJuridique
    usecase &#34;UC-06 : CrÃ©er/Modifier\nun courrier sortant&#34; as UC_CreerSortant
    usecase &#34;UC-07 : Modifier\nun document&#34; as UC_Modifier
    usecase &#34;UC-08 : Supprimer un document\n(soft delete â†’ corbeille)&#34; as UC_Supprimer
    usecase &#34;UC-09 : Consulter les dÃ©tails\nd&#39;un document&#34; as UC_Detail
    usecase &#34;UC-10 : TÃ©lÃ©charger\nun fichier&#34; as UC_Download
    usecase &#34;UC-11 : Importer des documents\nvia Excel&#34; as UC_ImportExcel
  }

  &#39; === TRANSFERT &amp; CIRCUIT ===
  rectangle &#34;Transfert &amp; Circuit Juridique&#34; {
    usecase &#34;UC-12 : TransfÃ©rer un document\n(unique / diffusion / 1..n)&#34; as UC_Transferer
    usecase &#34;UC-13 : TransfÃ©rer un dossier\njudiciaire (circuit)&#34; as UC_TransferJuridique
    usecase &#34;UC-14 : Avancer l&#39;Ã©tape\njudiciaire (Jalsat)&#34; as UC_AvancerEtape
    usecase &#34;UC-15 : Reculer l&#39;Ã©tape\njudiciaire (retour)&#34; as UC_ReculerEtape
    usecase &#34;UC-16 : Ouvrir un dossier\njudiciaire&#34; as UC_OuvrirDossier
    usecase &#34;UC-17 : ClÃ´turer un dossier&#34; as UC_ClÃ´turer
  }

  &#39; === TRANSACTIONS &amp; NOTIFICATIONS ===
  rectangle &#34;Transactions &amp; Notifications&#34; {
    usecase &#34;UC-18 : Accepter un transfert&#34; as UC_Accepter
    usecase &#34;UC-19 : Refuser un transfert\n(motif obligatoire)&#34; as UC_Refuser
    usecase &#34;UC-20 : Annuler un transfert&#34; as UC_Annuler
    usecase &#34;UC-21 : Consulter les\ntransactions en cours&#34; as UC_Transactions
    usecase &#34;UC-22 : Voir les notifications\n+ doit-revenir&#34; as UC_Notifications
  }

  &#39; === RECHERCHE &amp; EXPORT ===
  rectangle &#34;Recherche &amp; Export&#34; {
    usecase &#34;UC-23 : Recherche avancÃ©e\nde documents&#34; as UC_Recherche
    usecase &#34;UC-24 : Exporter en Excel&#34; as UC_ExportExcel
    usecase &#34;UC-25 : Exporter en Word&#34; as UC_ExportWord
  }

  &#39; === ESPACE DE TRAVAIL ===
  rectangle &#34;Espace de travail&#34; {
    usecase &#34;UC-26 : Ouvrir l&#39;espace\nde travail (ACL)&#34; as UC_Workspace
    usecase &#34;UC-27 : Ajouter des notes&#34; as UC_Notes
    usecase &#34;UC-28 : Consulter l&#39;historique\ndes modifications&#34; as UC_Historique
  }

  &#39; === MES ENTITÃ‰S ===
  rectangle &#34;Mes EntitÃ©s&#34; {
    usecase &#34;UC-29 : Consulter mes entitÃ©s\n(documents reÃ§us)&#34; as UC_MesEntites
    usecase &#34;UC-30 : Consulter mes dossiers\nen cours&#34; as UC_DossiersEnCours
  }

  &#39; === ARCHIVES ===
  rectangle &#34;Archives &amp; Corbeille&#34; {
    usecase &#34;UC-31 : Archiver un document&#34; as UC_Archiver
    usecase &#34;UC-32 : Voir la corbeille&#34; as UC_VoirCorbeille
    usecase &#34;UC-33 : Restaurer un document&#34; as UC_Restaurer
    usecase &#34;UC-34 : Supprimer dÃ©finitivement&#34; as UC_PermanentDelete
    usecase &#34;UC-35 : Voir les archives&#34; as UC_VoirArchives
    usecase &#34;UC-36 : Enregistrer un retrait\nde dossier&#34; as UC_Retrait
  }

  &#39; === ADMINISTRATION RBAC ===
  rectangle &#34;Administration RBAC&#34; {
    usecase &#34;UC-37 : GÃ©rer les utilisateurs\n(CRUD + soft-delete)&#34; as UC_GererUsers
    usecase &#34;UC-38 : GÃ©rer les services\nRBAC (soft-delete)&#34; as UC_GererServices
    usecase &#34;UC-39 : GÃ©rer la matrice\ndes permissions\n(18 permissions)&#34; as UC_GererPermissions
    usecase &#34;UC-40 : GÃ©rer les overrides\nadmin (sÃ©paration)&#34; as UC_GererAdminOverrides
    usecase &#34;UC-41 : GÃ©rer les\nÃ©quipements&#34; as UC_GererEquipements
    usecase &#34;UC-42 : GÃ©rer les listes\ndynamiques&#34; as UC_GererListes
    usecase &#34;UC-43 : GÃ©rer les services\nhistoriques&#34; as UC_GererServicesHist
  }
}

